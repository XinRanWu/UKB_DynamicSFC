                % --- Z-score 并处理常数列 ---
                X2 = zscore(X2);
                Y2 = zscore(Y2);
                M2 = zscore(M2);
                
                if ~isempty(COV2)
                    COV2 = zscore(COV2);
                    COV2(:, all(isnan(COV2))) = [];
                end
                
                % --- 检查是否存在NaN ---
                if any(isnan(X2)) || any(isnan(Y2)) || any(isnan(M2))
                    warning('NaN detected after zscore. Skipping...');
