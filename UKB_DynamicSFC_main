            Xvar = UKB_BrainXY{:, XList{i}};Yvar = UKB_BrainXY{:, YList{j}};Mvar = UKB_BrainXY{:, MList{m}};
            try
                [X2, Y2, M2, COV2] = nanrm(Xvar, Yvar, Mvar, COV0);
                % --- 检查有效行数 ---
                if numel(X2) < 50
                    warning('Too few valid samples after NaN removal.');
